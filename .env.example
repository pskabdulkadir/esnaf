# Server Configuration
PORT=3000
NODE_ENV=production

# Render.com Deployment (set RENDER=true when deploying to Render)
RENDER=false
# Set RENDER=true in Render dashboard environment variables
# This enables automatic /var/data path detection for persistent disk

# Google Integration (Optional)
GOOGLE_ANALYTICS_ID=
GOOGLE_ADS_ID=

# Application URLs
PRODUCTION_URL=https://yourdomain.com
# For Render: https://YOUR_APP_NAME.onrender.com

# Database (Local JSON file, no configuration needed)
# Local Development: ./db_data.json
# Render Production: /var/data/db_data.json (auto-detected)

# Development (Optional)
VITE_DEBUG=false

# Server Configuration
PORT=3000
NODE_ENV=production

# Render.com Deployment
RENDER=false
# For Render: Set RENDER=true in Render dashboard

# ============================================
# 🔥 Firebase Configuration (CRITICAL)
# ============================================
# Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# indirdiğiniz JSON dosyasından bu bilgileri alıp doldurun

FIREBASE_PROJECT_ID=siftah-app-v1
FIREBASE_PRIVATE_KEY_ID=replace-with-rotated-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n[SET_IN_SECRET_MANAGER_ONLY]\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@siftah-app-v1.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=111060470180634756523
FIREBASE_DATABASE_URL=https://siftah-app-v1.firebaseio.com

# Google Integration (Optional)
GOOGLE_ANALYTICS_ID=
GOOGLE_ADS_ID=

# Application URLs
PRODUCTION_URL=https://yourdomain.com
# For Render: https://YOUR_APP_NAME.onrender.com

# Development (Optional)
VITE_DEBUG=false
